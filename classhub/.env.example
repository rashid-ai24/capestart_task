# ============================================
# ClassHub Environment Variables
# Copy this file to .env and update values
# ============================================

# ============================================
# Django Settings
# ============================================
DJANGO_ENV=development
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_DB=classhub
POSTGRES_USER=classhub_user
POSTGRES_PASSWORD=classhub_secure_password_change_me

# ============================================
# Redis Cache
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# RabbitMQ Message Queue
# ============================================
RABBITMQ_USER=classhub
RABBITMQ_PASSWORD=classhub_rabbitmq_change_me

# ============================================
# MinIO Object Storage
# ============================================
MINIO_ROOT_USER=classhub_admin
MINIO_ROOT_PASSWORD=classhub_minio_password_change_me
MINIO_BUCKET_NAME=classhub-media

# ============================================
# Elasticsearch
# ============================================
ELASTICSEARCH_URL=http://elasticsearch:9200

# ============================================
# Celery Settings
# ============================================
CELERY_CONCURRENCY=4
CELERY_TIMEZONE=Asia/Kolkata

# ============================================
# Frontend Settings
# ============================================
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_NAME=ClassHub
VITE_APP_VERSION=1.0.0

# ============================================
# Authentication
# ============================================
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# ============================================
# Email Settings (SMTP)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@classhub.com

# ============================================
# SMS Settings (Twilio/MSG91)
# ============================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890
MSG91_API_KEY=your-msg91-key

# ============================================
# Payment Gateway (Stripe/Razorpay)
# ============================================
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ============================================
# Plagiarism Detection
# ============================================
PLAGIARISM_API_KEY=your-plagiarism-api-key

# ============================================
# Monitoring
# ============================================
SENTRY_DSN=your-sentry-dsn
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ============================================
# File Upload Limits
# ============================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,zip,jpg,jpeg,png
